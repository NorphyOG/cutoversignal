{
  "name": "cutoversignal",
  "version": "0.3.1",
  "description": "Credential-free Exchange Web Services migration readiness and Microsoft Graph planning scanner.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorphyOG/cutoversignal.git"
  },
  "homepage": "https://github.com/NorphyOG/cutoversignal#readme",
  "bugs": {
    "url": "https://github.com/NorphyOG/cutoversignal/issues"
  },
  "keywords": [
    "ews",
    "exchange-web-services",
    "microsoft-graph",
    "migration-readiness",
    "static-analysis"
  ],
  "bin": {
    "cutoversignal": "bin/cutoversignal.mjs"
  },
  "files": [
    ".github",
    "bin",
    "dist",
    "src",
    "scripts",
    "test",
    "docs",
    "action.yml",
    "LICENSE",
    "MANIFEST.sha256",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "scan": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli.ts",
    "prepack": "npm run build && npm test",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts"
  }
}
